---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import VaccineCalendar from "../components/VaccineCalendar.astro";
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";
import store from "../assets/vacinas-store.jpg";
import { wa } from "../data/site";
import { storeGroups } from "../data/vaccines";
const msg = "Olá! Gostaria de informações sobre vacinas na Clipe Vacinas Store.";
---
<Base title="Clipe Vacinas Store — vacinas para todas as idades" description="Clipe Vacinas Store: vacinas para bebês, crianças, adolescentes, gestantes, adultos e 60+, dentro da Clínica Clipe em Pontes e Lacerda/MT. Calendário de vacinação interativo." waMessage={msg}>
  <PageHero
    eyebrow="Dentro da Clínica Clipe"
    title="Clipe *Vacinas Store*"
    lead="Vacinas para todas as idades, com aplicação segura e humanizada, em um espaço pensado para o conforto de toda a família."
    crumbs={[{ href: "/vacinas-store/", label: "Vacinas Store" }]}
  >
    <div class="btns reveal" style="--d:4">
      <a class="btn" href={wa(msg)} target="_blank" rel="noopener" data-magnetic><Icon name="whatsapp" /> Consultar vacinas</a>
      <a class="btn btn-ghost" href="#disponiveis"><Icon name="syringe" /> Vacinas disponíveis</a>
      <a class="btn btn-ghost" href="#calendario"><Icon name="calendar" /> Calendário por idade</a>
    </div>
  </PageHero>

  <section class="section pillars-section">
    <div class="wrap pillars">
      <div class="store-photo reveal-img">
        <Image src={store} alt="Painel circular iluminado da Clipe Vacinas Store" widths={[600, 1000]} sizes="(max-width: 900px) 92vw, 50vw" />
      </div>
      <div class="grid g2">
        <div class="pill-card card reveal" style="--d:0"><span class="icon-bubble" style="--accent:var(--blue)"><Icon name="baby" /></span><h3>Bebês e crianças</h3><p>Calendário infantil completo e vacinas complementares.</p></div>
        <div class="pill-card card reveal" style="--d:1"><span class="icon-bubble" style="--accent:var(--pink)"><Icon name="heart" /></span><h3>Gestantes</h3><p>Proteção para a mãe e para o bebê desde a gestação.</p></div>
        <div class="pill-card card reveal" style="--d:2"><span class="icon-bubble" style="--accent:var(--green)"><Icon name="growth" /></span><h3>Adolescentes</h3><p>HPV, meningocócicas e reforços na idade certa.</p></div>
        <div class="pill-card card reveal" style="--d:3"><span class="icon-bubble" style="--accent:var(--lilac)"><Icon name="family" /></span><h3>Adultos e 60+</h3><p>Gripe, reforços, herpes zóster e mais.</p></div>
      </div>
    </div>
  </section>

  <section class="section bg-white" id="disponiveis">
    <div class="wrap">
      <div class="section-head split">
        <div>
          <p class="eyebrow reveal">Na Clipe Vacinas Store</p>
          <h2 class="reveal" style="--d:1">Vacinas e imunizantes <em>disponíveis</em></h2>
        </div>
        <p class="lead reveal" style="--d:2">O esquema de doses pode variar conforme a idade, o histórico vacinal e a indicação médica. Fale com a gente para montar o calendário da sua família.</p>
      </div>
      <div class="store-grid">
        {storeGroups.map((g, i) => (
          <div class="sg card reveal" style={`--d:${i % 3};--accent:${g.accent}`}>
            <div class="sg-head"><span class="icon-bubble"><Icon name={g.icon} /></span><h3>{g.title}</h3></div>
            <ul>
              {g.items.map((it) => (
                <li><b>{it.name}</b>{it.note && <small>{it.note}</small>}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="reveal" style="margin-top:28px">
        <a class="btn" href={wa("Olá! Gostaria de saber sobre disponibilidade e valores de vacinas na Clipe Vacinas Store.")} target="_blank" rel="noopener"><Icon name="whatsapp" /> Consultar disponibilidade e valores</a>
      </div>
    </div>
  </section>

  <section class="section bg-sand" id="calendario">
    <div class="wrap">
      <div class="section-head split">
        <div>
          <p class="eyebrow reveal">Calendário interativo</p>
          <h2 class="reveal" style="--d:1">Quais vacinas <em>em cada idade?</em></h2>
        </div>
        <p class="lead reveal" style="--d:2">Escolha a idade e veja as vacinas recomendadas. Depois é só consultar a disponibilidade com a nossa equipe.</p>
      </div>
      <VaccineCalendar />
    </div>
  </section>

  <CtaBand title="Traga a *caderneta de vacinação*" text="Nossa equipe confere o histórico e orienta quais vacinas estão em dia e quais faltam." message="Olá! Gostaria de conferir a caderneta de vacinação na Clipe Vacinas Store." />
</Base>

<style>
  .btns { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 30px; }
  .pillars-section { padding-top: 30px; }
  .pillars { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
  .store-photo { border-radius: var(--r-lg); overflow: hidden; aspect-ratio: 1; }
  .store-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .pill-card { padding: 26px; display: grid; gap: 10px; }
  .pill-card p { margin: 0; color: var(--brown-2); font-size: 15px; }
  .store-grid { columns: 3 300px; column-gap: 20px; }
  .sg { break-inside: avoid; padding: 26px; margin-bottom: 20px; display: block; }
  .sg-head { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
  .sg-head h3 { font-size: 22px; }
  .sg ul { list-style: none; padding: 0; margin: 0; }
  .sg li { padding: 10px 0; border-top: 1px solid #f0e8dd; line-height: 1.35; }
  .sg li b { display: block; font-size: 15.5px; }
  .sg li small { color: var(--brown-3); font-size: 13px; }
  @media (max-width: 900px) { .pillars { grid-template-columns: 1fr; } }
</style>
