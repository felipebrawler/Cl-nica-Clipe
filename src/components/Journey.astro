---
import Icon from "./Icon.astro";
import { phases, servicesByPhase, serviceHref } from "../data/services";
---
<section class="section journey-section" id="fases">
  <div class="wrap">
    <div class="section-head center">
      <p class="eyebrow reveal">O conceito Clipe</p>
      <h2 class="reveal" style="--d:1">Cuidado em <em>todas as fases</em></h2>
      <p class="lead reveal" style="--d:2">Acompanhamos a sua família do primeiro ultrassom à vida adulta. Role para percorrer a jornada.</p>
    </div>

    <div class="journey" data-journey>
      <aside class="rail" aria-hidden="true">
        <div class="rail-track"><div class="rail-fill" data-rail-fill></div></div>
        <ol>
          {phases.map((p, i) => (
            <li data-node={p.id} style={`--accent:${p.accent}`}>
              <span class="node"><Icon name={p.icon} /></span>
              <span class="node-label"><small>0{i + 1}</small>{p.title}</span>
            </li>
          ))}
        </ol>
      </aside>

      <div class="panels">
        {phases.map((p, i) => {
          const list = servicesByPhase(p.id);
          return (
            <article class="panel" id={`fase-${p.id}`} data-panel={p.id} style={`--accent:${p.accent}`}>
              <div class="panel-head">
                <span class="big-num">0{i + 1}</span>
                <div>
                  <p class="kicker">{p.kicker}</p>
                  <h3>{p.title}</h3>
                </div>
              </div>
              <p class="panel-text">{p.text}</p>
              <ul class="svc-list">
                {list.map((s, j) => (
                  <li style={`--i:${j}`}>
                    <a href={serviceHref(s)}>
                      <span class="ic"><Icon name={s.icon} /></span>
                      <span class="t">{s.title}</span>
                      <Icon name="arrow" class="go" />
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style>
  .journey { display: grid; grid-template-columns: 300px 1fr; gap: clamp(32px, 6vw, 96px); }
  .rail { position: sticky; top: calc(var(--header-h) + 40px); align-self: start; height: max-content; }
  .rail ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 34px; position: relative; }
  .rail-track { position: absolute; left: 27px; top: 28px; bottom: 28px; width: 2px; background: var(--line); border-radius: 2px; }
  .rail-fill { width: 100%; height: 0; background: linear-gradient(var(--pink), var(--blue), var(--green), var(--lilac)); border-radius: 2px; transition: height .2s linear; }
  .rail li { cursor: pointer; display: flex; align-items: center; gap: 18px; position: relative; opacity: .5; transition: opacity .5s var(--ease); }
  .rail li.active, .rail li.done { opacity: 1; }
  .node { width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; background: var(--cream); box-shadow: inset 0 0 0 2px var(--line); transition: all .6s var(--ease); flex: none; }
  .node :global(.icon) { width: 26px; height: 26px; }
  .rail li.active .node { background: var(--accent); color: #fff; box-shadow: 0 0 0 8px color-mix(in srgb, var(--accent) 22%, transparent); transform: scale(1.08); }
  .rail li.done .node { background: #fff; box-shadow: inset 0 0 0 2px var(--accent); }
  .node-label { font: 560 20px/1.2 var(--serif); }
  .node-label small { display: block; font: 800 11px/1 var(--sans); letter-spacing: .2em; color: var(--gold); margin-bottom: 4px; }

  .panels { display: grid; gap: clamp(60px, 10vh, 120px); padding-bottom: 10vh; }
  .panel { min-height: 54vh; display: flex; flex-direction: column; justify-content: center; opacity: .25; transform: translateY(20px); transition: opacity .9s var(--ease), transform .9s var(--ease); }
  .panel.active, .panel.seen { opacity: 1; transform: none; }
  .panel-head { display: flex; align-items: center; gap: 22px; margin-bottom: 18px; }
  .big-num { font: italic 300 clamp(80px, 10vw, 140px)/0.8 var(--serif); color: color-mix(in srgb, var(--accent) 70%, #fff); letter-spacing: -.04em; }
  .kicker { margin: 0 0 6px; font-weight: 800; font-size: 13px; letter-spacing: .18em; text-transform: uppercase; color: var(--brown-3); }
  .panel h3 { font-size: clamp(34px, 4vw, 52px); }
  .panel-text { font-size: 19px; color: var(--brown-2); max-width: 560px; margin-bottom: 30px; }
  .svc-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .svc-list li { opacity: 0; transform: translateY(14px); transition: opacity .7s var(--ease), transform .7s var(--ease); transition-delay: calc(var(--i) * 60ms + 150ms); }
  .panel.active .svc-list li, .panel.seen .svc-list li { opacity: 1; transform: none; }
  .svc-list a { display: flex; align-items: center; gap: 14px; padding: 14px 16px; background: #fff; border-radius: 16px; text-decoration: none; box-shadow: var(--shadow); font-weight: 700; font-size: 15.5px; transition: transform .5s var(--ease), box-shadow .5s var(--ease); }
  .svc-list a:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .svc-list .ic { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: color-mix(in srgb, var(--accent) 18%, #fff); flex: none; }
  .svc-list .ic :global(.icon) { width: 22px; height: 22px; }
  .svc-list .t { flex: 1; line-height: 1.3; }
  .svc-list :global(.go) { width: 18px; color: var(--lilac-deep); opacity: 0; transform: translateX(-6px); transition: all .4s var(--ease); }
  .svc-list a:hover :global(.go) { opacity: 1; transform: none; }

  @media (max-width: 900px) {
    .journey { grid-template-columns: 1fr; gap: 24px; }
    .rail { top: calc(var(--header-h) - 4px); z-index: 5; background: color-mix(in srgb, var(--cream) 92%, transparent); backdrop-filter: blur(10px); margin: 0 -28px; padding: 10px 28px; }
    .rail ol { grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .rail li { flex-direction: column; gap: 6px; text-align: center; }
    .node { width: 42px; height: 42px; }
    .node :global(.icon) { width: 20px; height: 20px; }
    .node-label { font: 700 11.5px/1.2 var(--sans); }
    .node-label small { display: none; }
    .rail-track { left: 40px; right: 40px; top: 31px; bottom: auto; width: auto; height: 2px; }
    .rail-fill { height: 100% !important; width: var(--w, 0%); background: linear-gradient(90deg, var(--pink), var(--blue), var(--green), var(--lilac)); }
    .panel { min-height: auto; }
    .svc-list { grid-template-columns: 1fr; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-journey]");
  if (root) {
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
    const nodes = [...root.querySelectorAll<HTMLElement>("[data-node]")];
    const fill = root.querySelector<HTMLElement>("[data-rail-fill]")!;
    const mobile = window.matchMedia("(max-width: 900px)");

    const setActive = (id: string) => {
      const idx = panels.findIndex((p) => p.dataset.panel === id);
      panels.forEach((p, i) => {
        p.classList.toggle("active", i === idx);
        if (i <= idx) p.classList.add("seen");
      });
      nodes.forEach((n, i) => {
        n.classList.toggle("active", i === idx);
        n.classList.toggle("done", i < idx);
      });
    };

    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && setActive((e.target as HTMLElement).dataset.panel!)),
      { rootMargin: "-45% 0px -45% 0px" }
    );
    panels.forEach((p) => io.observe(p));

    const progress = () => {
      const r = root.getBoundingClientRect();
      const vh = window.innerHeight;
      const p = Math.min(1, Math.max(0, (vh * 0.5 - r.top) / (r.height - vh * 0.3)));
      if (mobile.matches) fill.style.setProperty("--w", `${p * 100}%`);
      else fill.style.height = `${p * 100}%`;
    };
    progress();
    window.addEventListener("scroll", progress, { passive: true });
    window.addEventListener("resize", progress);
    nodes.forEach((n) =>
      n.addEventListener("click", () => document.getElementById(`fase-${n.dataset.node}`)?.scrollIntoView({ block: "center" }))
    );
  }
</script>
